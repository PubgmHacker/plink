# ─────────────────────────────────────────────────────────────────────────────
# Plink backend — environment template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=8080

# Database
DATABASE_URL="postgresql://user:pass@host:port/dbname"
# Prisma pool per replica. Total Postgres connections = DB_POOL_SIZE x replicas,
# keep under max_connections with ~10 spare for migrations/psql.
# Example: max_connections=100, 4 replicas -> DB_POOL_SIZE=20.
DB_POOL_SIZE=15
DB_POOL_TIMEOUT_S=20

# Redis (required for multi-replica realtime state — see Stage 3)
REDIS_URL="redis://localhost:6379"

# JWT — generate both separately: openssl rand -hex 32
# Both MUST be distinct and >=32 chars in production.
JWT_SECRET="replace-with-strong-32-char-min-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-32-char-secret"
JWT_ISSUER=plink
# Add Android/desktop only when those signed clients actually ship.
JWT_AUDIENCES=plink-ios
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=90
REALTIME_TICKET_TTL_SEC=60

# CORS — allowlist in production; dev reflects any origin automatically.
# Tauri desktop origins (tauri://localhost, http://tauri.localhost) are always allowed for WebSocket.
CORS_ORIGIN="https://app.plink.example,https://staging.plink.example,https://plink.vercel.app"

# Public API base URL (avatar links, OpenAPI)
PUBLIC_BASE_URL="https://plink-production.up.railway.app"

# Лендинги (web.ts): базовый origin для canonical/OG-ссылок.
# Пока DNS plink.app не настроен — ставить домен Railway.
PUBLIC_ORIGIN="https://plink-production.up.railway.app"
# Кнопки установки на лендингах. До релиза достаточно TESTFLIGHT_URL —
# он имеет приоритет над APP_STORE_URL. ANDROID_STORE_URL пуст = «скоро».
APP_STORE_URL="https://apps.apple.com/app/id0000000000"
TESTFLIGHT_URL=""
ANDROID_STORE_URL=""

# Веб-подписка Plink+ (/plus, routes/webpay.ts) — оплата через ЮKassa.
# Ключи: yookassa.ru → Интеграция → Ключи API. Без ключей оплата на сайте
# выключена (страница честно пишет «подключается»), всё остальное работает.
# Webhook в кабинете ЮKassa: {PUBLIC_ORIGIN}/api/webpay/yookassa/webhook,
# событие payment.succeeded.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# true — слать чек 54-ФЗ (если в магазине включена фискализация)
YOOKASSA_SEND_RECEIPT=false
# Цены веб-тарифов в рублях (формат 199.00). Должны совпадать по смыслу
# с ценами StoreKit в App Store Connect.
PLUS_PRICE_1M="199.00"
PLUS_PRICE_3M="499.00"
PLUS_PRICE_12M="1490.00"

# Dev emergency DB wipe — disabled in production MVP.
# Leave DEV_WIPE_SECRET empty while disabled.
DEV_WIPE_SECRET=""
ENABLE_DEV_WIPE=false

# IAP verification is fail-closed. Sandbox belongs on a separate staging service.
ALLOW_UNVERIFIED_IAP=false
ALLOW_SANDBOX_IAP=false
APPLE_BUNDLE_ID="com.syncwatch.plink"
APPLE_TEAM_ID=""
APPLE_ROOT_CERT_PATH=""
APPLE_ROOT_CA_PEM=""

# Feature flags. The values below are the production defaults.
APP_STORE_COMPLIANT=true
ENABLE_LEGACY_STREAM_RELAY=false
REALTIME_PROTOCOL_V2=true
NATIVE_PLAYER_V2=true
LIVEKIT_SFU=false
WATCH_SCREEN_V2=false

# B5: AI structured actions feature flag.
# Set to true ONLY after function/tool calling is implemented.
# Default: false (keyword detection is prototype, not for external beta).
AI_ACTIONS_ENABLED=false

# B1: Bootstrap admin allowlist (comma-separated emails).
# Used by scripts/bootstrap-admin.js. Only emails in this list can be
# promoted to ADMIN/FOUNDER via the bootstrap script.
ALLOWED_BOOTSTRAP_ADMINS=""
PRIVILEGED_ADMIN_EMAILS=""
PRIVILEGED_FOUNDER_EMAILS=""
ADMIN_STEPUP_CODE=""
METRICS_TOKEN=""
# Generate before enabling 2FA: openssl rand -base64 32; keep stable.
TWOFA_ENC_KEY=""

# AI — server-side only. Never put these values in the iOS bundle.
OPENROUTER_API_KEY=""
AI_MODEL="openai/gpt-4o-mini"
AI_NSFW_MODEL=""
YOUTUBE_API_KEY=""

# LiveKit (Stage 9)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# APNs push (optional until external beta)
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID="com.syncwatch.plink"
APNS_PRODUCTION=true

# Observability
SENTRY_DSN=""
OTEL_ENDPOINT=""
SLACK_WEBHOOK_URL=""

# Android verification (future)
ANDROID_CERT_SHA256=""

# Media (signed URL TTL in seconds; 60-300)
SIGNED_MEDIA_URL_TTL=120
