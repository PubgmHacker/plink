# ─── macOS ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
# Finder's custom folder icon is a file literally named "Icon\r" — five
# characters. The pattern must stay anchored: an unanchored `Icon?` also
# matches directories such as docs/icons and silently drops them.
/Icon?
._*
.Spotlight-V100
.Trashes

# ─── Xcode (project is generated by XcodeGen — do NOT commit .xcodeproj) ─
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.xccheckout
*.moved-aside
DerivedData/
build/
Build/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ─── Swift Package Manager ──────────────────────────────
.swiftpm/
Package.resolved
.build/
# Resolved dependency checkouts. Both CI and the local build commands in
# docs/runbooks/ios-build-and-release.md pass
# `-clonedSourcePackagesDirPath .spm-cache`, so this directory appears as soon as
# anyone builds — 1.4 GB across ~29,500 files, none of it ours. It was not ignored,
# which meant a single `git add -A` would try to commit all of it; GitHub rejects
# blobs over 100 MB, and anything that did land would stay in history permanently.
.spm-cache/

# ─── Node / backend ─────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
dist/
coverage/
.nyc_output/
*.tsbuildinfo

# ─── Prisma ─────────────────────────────────────────────
prisma/migrations/dev.db*
*.db-journal

# ─── Secrets (NEVER commit) ─────────────────────────────
.env
.env.*
!.env.example
Secrets.xcconfig
GoogleService-Info.plist
*.p8
*.p12
AuthKey_*.p8

# ─── Logs / runtime ─────────────────────────────────────
*.log
logs/
.env.local

# Local scratch scripts — they tend to hold real keys. Never commit.
test.py
*.local.py

# Local tool configuration that holds real keys. Never commit.
opencode.json
check.sh

# ─── Python (asset build scripts) ───────────────────────
__pycache__/
*.pyc

# ─── Local editor / tooling artifacts ───────────────────
# .freebuff/ is a third-party editor's local SQLite store (desktop-v2.db plus
# its WAL/SHM files, ~14 MB). Not an artifact of this project.
.freebuff/

# Config backups (project.yml.bak and friends). Version history lives in git,
# not in a .bak suffix.
*.bak
*.orig

# ─── Generated preview / QA artifacts ───────────────────
# Both directories hold rendered PNGs and one-off HTML pages produced by the
# screenshot tests (see ios/PlinkTests/DesignAuditShots.swift and MarketingShots.swift).
# They were tracked once, which meant every render churned binary diffs; the tests
# write them on demand and nothing reads them from version control.
#
# Anchored with a leading slash, and it matters: unanchored `qa/` matches a directory
# named qa at ANY depth, which silently swallowed docs/qa/ — the QA strategy simply
# never got committed and `git add` reported nothing wrong. Both artifact directories
# live at the repository root; keep these anchored. Same hazard as /Icon? above.
/output/
/qa/
plink-tap-mock.html

# Redis dump written by a locally-run redis-server. Not an artifact of this project.
dump.rdb
