{
  "name": "plink-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Plink MVP scripts",
  "scripts": {
    "drift-lab": "node scripts/drift-lab.mjs",
    "ios:gen": "xcodegen generate",
    "android:apk": "cd android-client && ./gradlew assembleDebug",
    "android:test": "cd android-client && ./gradlew testDebugUnitTest",
    "landing:dev": "npm --prefix ../landing run dev",
    "landing:build": "npm --prefix ../landing run build",
    "backend:dev": "npm --prefix ../backend run dev",
    "backend:build": "npm --prefix ../backend run build",
    "backend:test": "npm --prefix ../backend test"
  },
  "devDependencies": {
    "ws": "^8.21.1"
  }
}
