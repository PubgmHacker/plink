// prisma/schema.prisma — Pack 5: с Referral, FeatureFlag, AdBreak моделями
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  FOUNDER
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  password     String
  avatarURL    String?
  /// Base64 data URL (data:image/jpeg;base64,...) — persisted in DB for Railway ephemeral FS.
  avatarData   String?
  /// Bumped only when avatar bytes change — used for friend-list cache bust (?v=).
  avatarUpdatedAt DateTime?
  /// 🔧 v11 (July 2026): Telegram-style display name (separate from @username).
  /// nil = use username as display name (backward compat).
  displayName  String?
  /// 🔧 v11: profile cover photo URL — banner shown on profile screen.
  coverURL     String?
  isOnline     Boolean  @default(false)
  /// Last time the user was seen online (login / WS / heartbeat). Used for «был(а) N мин назад».
  lastSeenAt   DateTime @default(now())
  isPremium    Boolean  @default(false)
  premiumUntil DateTime?
  role         UserRole @default(USER)
  bannedUntil  DateTime?
  /// Аудит 26.07.2026: теневой бан — человек пишет, но его не видят остальные.
  shadowbanned Boolean  @default(false)
  fcmToken     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  twofaSecret      String?
  twofaEnabled     Boolean  @default(false)
  twofaBackupCodes String?

  referralCode String?

  // ─── V5 (Phase 4 of PLINK_MASTER_PLAN_10_OF_10.md) ───
  /// JSON-stringified { appThemeID, bubbleStyleID, emojiPackID } for
  /// cross-device appearance restore. Null = use client defaults.
  appearancePrefs         String?
  /// GDPR: when set, account is scheduled for cascade deletion after the
  /// grace period (14 days). User can cancel by signing in before then.
  /// A cron job (services/gdpr.ts) performs the actual delete.
  scheduledForDeletionAt  DateTime?
  /// Telegram-style soft delete. When set, profile is «Удалённый аккаунт»:
  /// PII stripped, login blocked, DMs rejected, UI shows tombstone avatar.
  deletedAt               DateTime?

  hostedRooms      Room[]            @relation("HostRooms")
  participations   RoomParticipant[]
  sentMessages     ChatMessage[]
  sentDMs          DirectMessage[]   @relation("SentDMs")
  receivedDMs      DirectMessage[]   @relation("ReceivedDMs")
  dmReactions      DirectMessageReaction[]
  dmPins           DirectMessagePin[] @relation("DMPins")
  friendRequestsSent     FriendRequest[]  @relation("RequestsSent")
  friendRequestsReceived FriendRequest[]  @relation("RequestsReceived")
  friendshipsInitiated   Friendship[]     @relation("FriendshipsInitiated")
  friendshipsReceived    Friendship[]     @relation("FriendshipsReceived")
  watchHistory     WatchHistory[]
  playbackStates   PlaybackState[]
  subscriptions    Subscription[]
  blockedUsers     UserBlock[]       @relation("Blocker")
  blockedBy        UserBlock[]       @relation("Blocked")
  reports          Report[]          @relation("Reporter")
  reportsResolved  Report[]          @relation("Resolver")
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  referralsMade    Referral[] @relation("Referrer")
  referralReceived Referral?  @relation("Referred")
  // PATCH 16: App Store Server API V2 transaction records
  transactions     TransactionRecord[]
}

model Room {
  id             String   @id @default(uuid())
  name           String
  hostID         String
  host           User     @relation("HostRooms", fields: [hostID], references: [id], onDelete: Cascade)
  hostName       String
  code           String   @unique
  mediaItem      String?
  isActive       Boolean  @default(true)
  /// Аудит 26.07.2026: скрыта до разбора жалоб.
  hidden         Boolean  @default(false)
  maxParticipants Int     @default(10)
  hostIsPremium  Boolean  @default(false)
  createdAt      DateTime @default(now())
  privacy        String   @default("public")
  password       String?

  // ─── V5 (Phase 4) ───
  /// JSON-stringified RoomAppearance { themeId, themeRevision, intensity,
  /// motionEnabled }. Host-authoritative; broadcast to all participants on
  /// change via WebSocket `room.appearance.updated` event.
  appearance     String?

  participants   RoomParticipant[]
  messages       ChatMessage[]
  playbackStates PlaybackState[]
  watchHistory   WatchHistory[]
  reports        Report[]          @relation("ReportedRoom")
  adBreaks       AdBreak[]

  // GPT-5 BE-P0-07: indexes for hot paths
  // - isActive+createdAt: Home "Сейчас смотрят" rail
  // - privacy+isActive: public discovery filtering
  // - hostID: "my rooms" query
  // - mediaItem: discovery/popular aggregation
  @@index([isActive, createdAt])
  @@index([privacy, isActive])
  @@index([hostID])
  @@index([mediaItem])
}

model RoomParticipant {
  id       String   @id @default(uuid())
  roomID   String
  room     Room     @relation(fields: [roomID], references: [id], onDelete: Cascade)
  userID   String
  user     User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([roomID, userID])
  @@index([userID, joinedAt])
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomID    String
  room      Room     @relation(fields: [roomID], references: [id], onDelete: Cascade)
  senderID  String
  sender    User     @relation(fields: [senderID], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  /// Optional room-chat attachment: "photo" for image messages (data lives in mediaData).
  mediaType String?
  mediaData String?  @db.Text
  /// Аудит 26.07.2026: автоскрытие с трёх независимых жалоб — до разбора модератором.
  hidden    Boolean  @default(false)

  @@index([roomID, createdAt])
  @@index([roomID, hidden])
}

model DirectMessage {
  id          String   @id @default(uuid())
  senderID    String
  sender      User     @relation("SentDMs", fields: [senderID], references: [id], onDelete: Cascade)
  receiverID  String
  receiver    User     @relation("ReceivedDMs", fields: [receiverID], references: [id], onDelete: Cascade)
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  /// Optional attachment: "voice" for friend voice notes (data lives in mediaData).
  mediaType   String?
  /// data:audio/mp4;base64,... — stored in DB (Railway ephemeral FS-safe).
  mediaData   String?  @db.Text
  mediaDurationSec Float?
  reactions   DirectMessageReaction[]
  /// Telegram-style reply: quoted message id (same thread).
  replyToID   String?
  replyTo     DirectMessage?  @relation("DMReply", fields: [replyToID], references: [id], onDelete: SetNull)
  replies     DirectMessage[] @relation("DMReply")
  /// Telegram-style forward attribution (snapshot survives source deletion).
  forwardedFromID   String?
  forwardedFromName String?
  /// Telegram-style edit marker and per-user delete list.
  editedAt      DateTime?
  deletedForIDs String[]  @default([])
  pins        DirectMessagePin[]

  @@index([senderID, receiverID])
  @@index([receiverID, createdAt])
  @@index([senderID, createdAt])
}

/// Telegram-style DM pin. One row per user view: «pin for me» creates one
/// row (owner = actor); «pin for both» creates a row for each participant.
model DirectMessagePin {
  id         String   @id @default(uuid())
  /// The user whose chat view shows this pin.
  ownerID    String
  owner      User     @relation("DMPins", fields: [ownerID], references: [id], onDelete: Cascade)
  /// DM thread peer (the chat partner of ownerID).
  peerID     String
  messageID  String
  message    DirectMessage @relation(fields: [messageID], references: [id], onDelete: Cascade)
  /// Who performed the pin action (either participant).
  pinnedByID String
  createdAt  DateTime @default(now())

  @@unique([ownerID, peerID, messageID])
  @@index([ownerID, peerID])
}

/// Telegram-style reactions on DMs (one emoji per user per message).
model DirectMessageReaction {
  id        String   @id @default(uuid())
  messageID String
  message   DirectMessage @relation(fields: [messageID], references: [id], onDelete: Cascade)
  userID    String
  user      User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageID, userID])
  @@index([messageID])
}

model FriendRequest {
  id         String   @id @default(uuid())
  fromUserID String
  fromUser   User     @relation("RequestsSent", fields: [fromUserID], references: [id], onDelete: Cascade)
  toUserID   String
  toUser     User     @relation("RequestsReceived", fields: [toUserID], references: [id], onDelete: Cascade)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@unique([fromUserID, toUserID])
}

model Friendship {
  id           String   @id @default(uuid())
  userID       String
  user         User     @relation("FriendshipsInitiated", fields: [userID], references: [id], onDelete: Cascade)
  friendID     String
  friend       User     @relation("FriendshipsReceived", fields: [friendID], references: [id], onDelete: Cascade)
  friendsSince DateTime @default(now())
  /// Per-user Telegram-style pin (only on the row userID=me → friendID).
  isPinned     Boolean  @default(false)
  /// Lower = higher in pinned section (0 = top).
  pinOrder     Int      @default(0)

  @@unique([userID, friendID])
  @@index([userID, isPinned, pinOrder])
}

model WatchHistory {
  id        String   @id @default(uuid())
  userID    String
  user      User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  roomID    String?
  room      Room?    @relation(fields: [roomID], references: [id], onDelete: SetNull)
  mediaTitle String?
  watchedAt DateTime @default(now())
}

model PlaybackState {
  id         String   @id @default(uuid())
  roomID     String
  room       Room     @relation(fields: [roomID], references: [id], onDelete: Cascade)
  userID     String?
  user       User?    @relation(fields: [userID], references: [id], onDelete: SetNull)
  currentTime    Float    @default(0)
  isPlaying   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  // P1-39: removed @@unique([roomID, userID]) from schema — migration uses
  // partial unique indexes instead (WHERE userID IS NOT NULL / IS NULL).
  // Prisma migrate diff now produces empty diff against fresh DB.
  @@index([roomID, updatedAt])
}

model Subscription {
  id                    String   @id @default(uuid())
  userID                String
  user                  User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  plan                  String   @default("monthly")
  isActive              Boolean  @default(true)
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  // PATCH 16: App Store Server API V2 fields
  /// Аудит 26.07.2026 (P2): @unique — ключ идемпотентности. Без него upsert в
  /// billing.ts плодил новую активную строку на каждый verify/renew, а веб-грант
  /// ЮKassa выдавался дважды при повторной доставке вебхука.
  originalTransactionId String?  @unique // stable across renewals
  environment           String?  // "Sandbox" | "Production"
  revokedAt             DateTime?
  lastVerifiedAt        DateTime?
  @@index([userID, isActive])
}

/// PATCH 16: Signed transaction records (JWS) from App Store Server API V2.
/// One row per verified transaction. Used for audit trail + revocation.
model TransactionRecord {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId         String   @unique  // stable per transaction
  originalTransactionId String
  productId             String
  environment           String   // "Sandbox" | "Production"
  jws                   String   @db.Text  // signed JWS from Apple
  expiresAt             DateTime?
  revocationDate        DateTime?
  verifiedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  @@index([userId, createdAt])
  @@index([originalTransactionId])
  @@index([productId])
}

/// Аудит 26.07.2026 (P2): обработанные App Store Server Notifications V2.
/// Apple ретраит доставку на любой не-2xx, поэтому один и тот же
/// notificationUUID приходит несколько раз; без дедупликации устаревший
/// DID_RENEW после REFUND возвращал премиум отозванному пользователю.
model AppleNotification {
  notificationUUID      String    @id
  notificationType      String
  originalTransactionId String?
  signedDate            DateTime?
  processedAt           DateTime  @default(now())
  @@index([originalTransactionId])
}

model UserBlock {
  id          String @id @default(uuid())
  blockerID   String
  blocker     User   @relation("Blocker", fields: [blockerID], references: [id], onDelete: Cascade)
  blockedID   String
  blocked     User   @relation("Blocked", fields: [blockedID], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([blockerID, blockedID])
}

/// Аудит 26.07.2026: модель умела жалобы ТОЛЬКО на комнату (`roomID`),
/// из-за чего routes/moderation.ts падал на первом запросе. App Review
/// требует возможность пожаловаться на конкретное сообщение и на человека,
/// поэтому добавлены общие поля цели, SLA и текст жалобы.
model Report {
  id          String   @id @default(uuid())
  reporterID  String
  reporter    User     @relation("Reporter", fields: [reporterID], references: [id], onDelete: Cascade)
  /// Ссылка на комнату сохранена для обратной совместимости со старыми записями.
  roomID      String?
  reportedRoom Room?   @relation("ReportedRoom", fields: [roomID], references: [id], onDelete: SetNull)
  /// "user" | "message" | "room"
  targetType  String   @default("room")
  /// Идентификатор объекта жалобы в рамках targetType.
  targetID    String?
  reason      String
  /// Свободный комментарий пользователя (до 1000 символов).
  comment     String?
  status      String   @default("pending")  // pending | resolved | dismissed
  /// Срок разбора: обещанные 24 часа с момента подачи.
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  resolver    User?    @relation("Resolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  /// Чем закончился разбор: dismiss | hide | ban
  resolution  String?

  @@index([status, createdAt])
  @@index([targetType, targetID])
  @@index([dueAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// Pack 5: НОВЫЕ МОДЕЛИ

model Referral {
  id          String   @id @default(uuid())
  referrerId  String
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String   @unique
  referred    User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  status      String   @default("completed")
  rewardDays  Int      @default(7)
  createdAt   DateTime @default(now())

  @@index([referrerId])
}

model FeatureFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AdBreak {
  id          String   @id @default(uuid())
  roomID      String
  room        Room     @relation(fields: [roomID], references: [id], onDelete: Cascade)
  startTime   Float
  endTime     Float
  adType      String   @default("preroll")
  createdAt   DateTime @default(now())

  @@index([roomID])
}

// GPT-5.6 §14: AI Moderation Audit
model AIModerationAudit {
  id             String   @id @default(cuid())
  roomId         String
  messageId      String
  subjectUserId  String
  action         String
  reasonCode     String
  confidence     Float?
  policyVersion  String
  modelVersion   String?
  evidenceHash   String
  reversible     Boolean  @default(true)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([subjectUserId, createdAt])
}

/// M16: групповые чаты (беседы) — полноценный мессенджер внутри Plink.
model GroupChat {
  id        String   @id @default(uuid())
  title     String
  ownerID   String
  createdAt DateTime @default(now())
  members   GroupMember[]
  messages  GroupMessage[]
}

model GroupMember {
  id       String    @id @default(uuid())
  groupID  String
  group    GroupChat @relation(fields: [groupID], references: [id], onDelete: Cascade)
  userID   String
  role       String    @default("member")
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([groupID, userID])
  @@index([userID])
}

model GroupMessage {
  id         String    @id @default(uuid())
  groupID    String
  group      GroupChat @relation(fields: [groupID], references: [id], onDelete: Cascade)
  senderID   String
  senderName String
  content    String
  deletedAt  DateTime?
  reactions  Json?
  /// "photo" — фото в беседе (data URL в mediaData, как в DM).
  mediaType  String?
  mediaData  String?   @db.Text
  createdAt  DateTime  @default(now())

  @@index([groupID, createdAt])
}
