# Контекст сборки образа для Railway и локального docker build.
#
# Dockerfile копирует только backend/, но контекстом по умолчанию идёт
# весь репозиторий — около 1,4 ГБ, из которых 277 МБ это .git, 514 МБ
# лендинг и 123 МБ iOS-проект. Всё это упаковывалось и уезжало в демон
# на каждом деплое. Ниже остаётся только то, что реально нужно серверу.

# Клиенты и артефакты, к бэкенду отношения не имеющие
ios/
landing/
output/
qa/
docs/

# История и служебное
.git/
.gitignore
.github/
.claude/
.DS_Store
**/.DS_Store
*.log

# Ставится и собирается внутри образа
**/node_modules/
**/dist/
**/coverage/
.venv/

# Секреты не должны попадать в слой образа.
# .env.example под шаблон не подпадает и остаётся в контексте.
**/.env
**/.env.local
